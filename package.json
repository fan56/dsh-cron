{
  "name": "@aiwayds/dsh-cron",
  "version": "0.1.0",
  "description": "dsh plugin: cron scheduling \u2014 bounded tasks with calendar & interval rules, delivered to live agents",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "skill",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test test/cron-expr.test.mjs test/window.test.mjs test/store.test.mjs test/scheduler.test.mjs test/tools.test.mjs",
    "smoke": "node scripts/smoke-boot.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "typescript": "^5.8.0",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "cron",
    "scheduler",
    "timer"
  ]
}
