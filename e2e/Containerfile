# e2e image: Ubuntu 24.04 + Node 22 + tmux + a global dsh install + the
# plugin tarball built from THIS source tree.
#
# BASE_IMAGE and NODE_DIST_BASE are build args so the same Containerfile
# works on the dev machine (registry/CDN mirrors where docker.io and
# nodejs.org are unreachable) and on CI (clean network, official defaults).

ARG BASE_IMAGE=docker.io/library/ubuntu:24.04
FROM ${BASE_IMAGE}

ARG NODE_VERSION=22.23.2
ARG NODE_DIST_BASE=https://nodejs.org/dist
ARG PNPM_VERSION=10.33.0
# DSH_VERSION is resolved by e2e/run-e2e.sh with the same "newest of the
# latest/next dist-tags" rule as ci.yml / release.yml (the alpha tag is
# retired) and always clears the plugin's peer floor (>= 0.1.5-rc.1). Pin
# an exact version for a deterministic rebuild with
# --build-arg DSH_VERSION=<version>.
ARG DSH_VERSION=

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils tmux git \
 && rm -rf /var/lib/apt/lists/*

# Node from the official dist tarball — no apt repository dependency,
# arch-agnostic (x64 / arm64).
RUN case "$(uname -m)" in \
      x86_64)  NODE_ARCH=x64 ;; \
      aarch64) NODE_ARCH=arm64 ;; \
      *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSL \
      "${NODE_DIST_BASE}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
 && node --version

# pnpm first, alone: a broken upstream dsh publish wave must not take the
# package manager down with it (the old combined install died on ETARGET and
# left the image without pnpm — exit 127 at the plugin build).
RUN npm install -g --no-fund --no-audit pnpm@${PNPM_VERSION} \
 && pnpm --version

# The dsh CLI installs into a scratch prefix as the publish wave's OWN
# closure: every @deepseek-ai/* range the version declares is pinned to its
# base version via npm overrides (same rationale as ci.yml — a caret range
# like ^0.1.5-rc.2 FLOATS to a newer prerelease in the same tower, so one
# incomplete upstream wave poisons plain installs of older complete versions
# too). The bin is symlinked onto PATH and the closure is exposed through
# DSH_CLOSURE_DIR for scripts/link-dsh-closure.mjs. run-e2e.sh falls back to
# the other dist-tag when this layer fails on a broken wave.
#
# The generator is a single line with NO dollar signs on purpose: Dockerfile
# ARG substitution is textual (it ignores shell quoting), so a JS template
# literal like `@dsh@${ver}` would be blanked to `@dsh@` before node runs.
RUN test -n "${DSH_VERSION}" \
      || (echo "DSH_VERSION build arg is required (e.g. --build-arg DSH_VERSION=0.1.5-rc.1)" >&2; exit 1) \
 && node -e 'const cp=require("node:child_process");const fs=require("node:fs");const ver=process.argv[1],dir=process.argv[2];const deps=JSON.parse(cp.execFileSync("npm",["view","@deepseek-ai/dsh@"+ver,"dependencies","--json"],{encoding:"utf8"}));const overrides={};for(const entry of Object.entries(deps||{})){if(entry[0].startsWith("@deepseek-ai/")&&/^[~^]/.test(entry[1]))overrides[entry[0]]=entry[1].replace(/^[~^]/,"")}fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(dir+"/package.json",JSON.stringify({name:"dsh-e2e-install",private:true,dependencies:{"@deepseek-ai/dsh":ver},overrides:overrides},null,2))' "${DSH_VERSION}" /opt/dsh-cli-install \
 && npm install --prefix /opt/dsh-cli-install --no-fund --no-audit \
 && ln -sf /opt/dsh-cli-install/node_modules/.bin/dsh /usr/local/bin/dsh \
 && dsh --version

ENV DSH_CLOSURE_DIR=/opt/dsh-cli-install/node_modules/@deepseek-ai

WORKDIR /app

# Build the plugin from source and pack the user-facing tarball into /dist.
# The frozen-lockfile retry covers lockfiles generated on another platform.
COPY . .
RUN (pnpm install --frozen-lockfile || pnpm install) \
 && node scripts/link-dsh-closure.mjs \
 && pnpm build \
 && pnpm pack \
 && mkdir -p /dist && mv *.tgz /dist/ \
 && ls -la /dist/

# The scenario suite is bind-mounted at /e2e by e2e/run-e2e.sh so test logic
# can iterate without an image rebuild.
CMD ["bash", "/e2e/scenarios/run-all.sh"]
